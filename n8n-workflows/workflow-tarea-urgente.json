{
  "name": "Workflow 1 - Tarea Urgente con IA",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "evento-tarea",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "w1-node-01",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "w1-webhook-id-01"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "w1-cond-01",
              "leftValue": "={{ $json.tarea.prioridad }}",
              "rightValue": "alta",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "w1-node-02",
      "name": "IF Prioridad Alta",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/api/chat",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "message",
              "value": "=Da un consejo breve (máx 2 frases) para gestionar esta tarea urgente: '{{ $('Webhook').item.json.tarea.titulo }}'"
            }
          ]
        },
        "options": {}
      },
      "id": "w1-node-03",
      "name": "Llamar IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 160]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "w1-asgn-01",
              "name": "urgente",
              "value": true,
              "type": "boolean"
            },
            {
              "id": "w1-asgn-02",
              "name": "consejo",
              "value": "={{ $json.respuesta }}",
              "type": "string"
            },
            {
              "id": "w1-asgn-03",
              "name": "timestamp",
              "value": "={{ new Date().toISOString() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "w1-node-04",
      "name": "Set Urgente True",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [920, 160]
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "w1-asgn-04",
              "name": "urgente",
              "value": false,
              "type": "boolean"
            },
            {
              "id": "w1-asgn-05",
              "name": "consejo",
              "value": "",
              "type": "string"
            },
            {
              "id": "w1-asgn-06",
              "name": "timestamp",
              "value": "={{ new Date().toISOString() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "w1-node-05",
      "name": "Set Urgente False",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, 440]
    },
    {
      "parameters": {
        "mode": "append",
        "options": {}
      },
      "id": "w1-node-06",
      "name": "Merge",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1160, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, urgente: $json.urgente, consejo: $json.consejo, timestamp: $json.timestamp }) }}",
        "options": {}
      },
      "id": "w1-node-07",
      "name": "Responder",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1400, 300]
    }
  ],
  "connections": {
    "Webhook": {
